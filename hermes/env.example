#!/usr/bin/env bash
# Copy to hermes/env.sh on the live host and fill in local values.
# Never commit the filled file.
export JAMES_LIVE=/opt/data/james-bsc-live-clean
export JAMES_DATA=/opt/data/james-bsc-live-clean/data
export BSC_WORKSPACE=/opt/data/james-bsc-live-clean/data/.ocplatform/workspace
export OPENCLAW_HOME=/opt/data/james-bsc-live-clean/data/.openclaw
export WACLI_STORE_DIR=/opt/data/james-bsc-live-clean/data/.wacli
export HOME=/opt/data/james-bsc-live-clean/data
export PATH=/opt/data/james-bsc-live-clean/bin:/opt/data/bin:$PATH
export BSC_PUBLIC_JID=
export BSC_DEV_JID=
export BSC_YEAR4_JID=
export BSC_JUNIOR_SCHOOL_JID=
export BSC_SPORT_ECAS_JID=
export BSC_PARENT_COMMUNITY_JID=
export BSC_YEAR4_SOURCE_ID=
export BSC_JUNIOR_SCHOOL_SOURCE_ID=
export BSC_SPORT_ECAS_SOURCE_ID=
export BSC_PARENT_COMMUNITY_SOURCE_ID=
export BSC_ADMIN_JIDS=
