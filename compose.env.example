# Optional local Compose overrides. Copy this file to .env; never put secrets
# here. Compose will otherwise use the pinned upstream image and safe defaults.
COMPOSE_PROJECT_NAME=james-local
JAMES_IMAGE=james-hermes:local
HERMES_IMAGE=nousresearch/hermes-agent@sha256:1071a9e60d3d6c445a3f81d2534823e8954ad5a10b130a4ceba71e5722529432
HERMES_DATA_VOLUME=james-hermes-data
HERMES_DASHBOARD=0
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
CODEX_VERSION=0.155.1
CODEX_MODEL=gpt-5.6-sol
CODEX_TIMEOUT_SECONDS=180
CODEX_HOME=/opt/codex
CODEX_HOME_VOLUME=james-codex-home
JAMES_LLM_FALLBACK_ENABLED=1
OPENROUTER_MODEL=
