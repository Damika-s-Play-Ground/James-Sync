# Provider settings. Copy into the runtime secret store; never commit a filled
# file. Codex uses the CLI's mounted CODEX_HOME/auth.json or CODEX_ACCESS_TOKEN.
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_TIMEOUT_SECONDS=180
CODEX_HOME=/opt/james-secrets/codex

# OpenRouter is used only after a Codex failure. Choose a model available to
# your OpenRouter account; no model is assumed by the code.
JAMES_LLM_FALLBACK_ENABLED=1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=James
